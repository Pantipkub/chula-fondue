# Local-only demo setup: npm run setup:demo writes .env.demo with a random secret.
# Copy this file to .env for custom configuration.
JWT_SECRET=
ADMIN_EMAIL=admin@fondue.test
ADMIN_PASSWORD=
EMAIL_MODE=record
AUTO_ROUTING_ENABLED=false

# Leave URLs unset for local databases provided by Compose.
# AUTH_DATABASE_URL=postgresql://...
# TICKET_DATABASE_URL=postgresql://...
# DEPARTMENT_DATABASE_URL=postgresql://...
# ANALYTICS_DATABASE_URL=postgresql://...
# MONGODB_URL=mongodb://...
# CLOUDINARY_URL=cloudinary://...

# Gmail is optional. Set EMAIL_MODE=gmail after obtaining consent with gmail.send scope.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_FROM=
WEB_PORT=8080
GATEWAY_PORT_HOST=3000
POSTGRES_PORT=5433
MONGO_PORT=27018
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
