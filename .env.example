# Copy to .env and fill in. .env holds passwords and must never be committed.

# PostgreSQL on Neon, one database per service.
# Leave these three out to use the local Postgres from docker-compose.yml instead
# (never set them to a localhost URL: inside Docker, localhost is the container itself).
AUTH_DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/auth?sslmode=require
TICKET_DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/ticket?sslmode=require
DEPARTMENT_DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/department?sslmode=require

# MongoDB for Notification Service. The database "notification" is created on first write.
# Leave it out to use the local "mongo" container (docker compose) or mongodb://localhost:27017 (npm run dev).
MONGODB_URL=mongodb+srv://<user>:<password>@<host>.mongodb.net/

# RabbitMQ for services run on the host (npm run dev). Leave it out: this is the default, and inside
# Docker Compose the services always use amqp://rabbitmq:5672 regardless of this value.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Cloudinary photo storage, from the Cloudinary dashboard ("API environment variable").
# Leave it out to save photos in services/api-gateway/uploads instead.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Signs login tokens. At least 32 random characters, the same value for Auth Service and API Gateway.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The first Admin account, created when Auth Service starts if it does not exist yet.
ADMIN_EMAIL=admin@chula.ac.th
ADMIN_PASSWORD=
