# Copy to .env and fill in. .env holds passwords and must never be committed.
# Lines starting with # are ignored. Only the four values in the "Required" part must be filled in.

# ---------- Required ----------

# MongoDB for Notification Service (ask the teammate who created the cluster).
# The database "notification" is created on first write.
MONGODB_URL=mongodb+srv://<user>:<password>@<host>.mongodb.net/

# Signs login tokens. At least 32 random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The first Admin account, created when Auth Service starts if it does not exist yet.
# The password needs at least 8 characters. Changing it later does not change an existing account.
ADMIN_EMAIL=admin@chula.ac.th
ADMIN_PASSWORD=

# ---------- Optional: remove the leading # only when you have the real value ----------

# PostgreSQL on Neon, one database per service.
# Without these three, the local Postgres from docker-compose.yml is used.
#AUTH_DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/auth?sslmode=require
#TICKET_DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/ticket?sslmode=require
#DEPARTMENT_DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/department?sslmode=require

# Cloudinary photo storage, from the Cloudinary dashboard ("API environment variable").
# Without it, photos are saved in services/api-gateway/uploads.
#CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# RabbitMQ. This is already the default and matches docker-compose.yml.
#RABBITMQ_URL=amqp://guest:guest@localhost:5672
