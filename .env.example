# Copy this file to .env at the repository root for local development.
# Values exported in your shell take precedence over this file.

# REST ports. When changing a port, update the matching URL below too.
GATEWAY_PORT=3000
DEPARTMENT_PORT=3001

# gRPC listener for ticket-service; 0.0.0.0 listens on all local interfaces.
TICKET_GRPC_URL=0.0.0.0:50051

# Addresses used by service clients and demo scripts.
TICKET_SERVICE_URL=localhost:50051
DEPARTMENT_SERVICE_URL=http://localhost:3001
GATEWAY_URL=http://localhost:3000

# Optional SQLite paths for local development; omitted values keep the original
# per-service database files. Compose sets /data paths and named volumes itself.
# DEPARTMENT_DB_PATH=/absolute/path/to/department.sqlite
# TICKET_DB_PATH=/absolute/path/to/ticket.sqlite
