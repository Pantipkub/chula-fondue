    },
    {
      "name": "2 Message broker (optional)",
      "description": "Shows RabbitMQ keeping a message. Send B1 before recording. Start the system with \"npm run dev:no-notification\", send B2 (still 200), show Ready = 1 for the notifications queue at http://localhost:15672, then run \"npm run notification\".",
      "item": [
        {
          "name": "B1 Reporter reports a second issue",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base}}/tickets",
            "auth": {
              "type": "bearer",
