        {
          "name": "2 UC-01 Reporter reports an issue with photos",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base}}/tickets",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reporterToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Pick the files for the \"photos\" field before sending (samples are in demo-progress2/photos).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "category",
                  "value": "Electrical",
                  "type": "text"
                },
                {
                  "key": "location",
                  "value": "ENG3 room 315",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Ceiling light is flickering",
                  "type": "text"
                },
                {
                  "key": "photos",
                  "type": "file",
                  "src": [
                    "photos/issue-1.png",
                    "photos/issue-2.jpg"
                  ]
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"ticketId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3 Role check: a Reporter cannot assign",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/tickets/{{ticketId}}/assign",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reporterToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentId\": \"{{departmentId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
