            }
          ]
        },
        {
          "name": "5 UC-02 Admin reviews submitted tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/tickets?status=SUBMITTED",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "6 UC-02 Admin assigns the ticket to the department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/tickets/{{ticketId}}/assign",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "After this, show the RabbitMQ message in the service log and the new record in MongoDB.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentId\": \"{{departmentId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
