{
  "name": "chula-fondue",
  "private": true,
  "workspaces": [
    "services/*",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n department,auth,ticket,notification,gateway -c blue,cyan,green,yellow,magenta \"npm start -w department-service\" \"npm start -w auth-service\" \"npm start -w ticket-service\" \"npm start -w notification-service\" \"npm start -w api-gateway\" \"npm start -w analytics-service\"",
    "dev:no-notification": "concurrently -n department,auth,ticket,gateway -c blue,cyan,green,magenta \"npm start -w department-service\" \"npm start -w auth-service\" \"npm start -w ticket-service\" \"npm start -w api-gateway\"",
    "notification": "npm start -w notification-service",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run build && npm run test:backend && npm run test:frontend",
    "test:backend": "node --test tests/*.test.mjs",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "test:coverage": "npm run build && c8 npm run test:backend && npm run test:frontend -- --coverage",
    "test:coverage:integration": "c8 --clean=false node --env-file-if-exists=.env.demo scripts/run-integration-tests.mjs",
    "test:coverage:demo": "npm run test:coverage && npm run test:coverage:integration",
    "test:e2e": "node --env-file-if-exists=.env.demo tests/e2e.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:ui:sonar": "node tests/ui-sonar.mjs",
    "test:ui:queue": "node tests/ui-staff-queue.mjs",
    "test:ui:responsive": "node tests/ui-responsive.mjs",
    "dev:web": "npm run dev -w chula-fondue-frontend",
    "setup:demo": "node scripts/setup-demo.mjs",
    "seed:demo": "node --env-file-if-exists=.env.demo scripts/seed-demo.mjs",
    "test:recovery": "node --env-file-if-exists=.env.demo tests/recovery.mjs",
    "test:routing": "node --env-file-if-exists=.env.demo tests/routing-e2e.mjs",
    "test:routing:recovery": "node --env-file-if-exists=.env.demo tests/routing-recovery.mjs",
    "test:ui:live": "node tests/ui-live.mjs",
    "test:postman": "npx --yes newman run postman/chula-fondue.postman_collection.json -e postman/environments/demo.postman_environment.json --working-dir ."
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "c8": "^12.0.0",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
