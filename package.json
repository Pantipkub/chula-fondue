{
  "name": "chula-fondue",
  "private": true,
  "workspaces": [
    "services/*",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n department,auth,ticket,notification,gateway -c blue,cyan,green,yellow,magenta \"npm start -w department-service\" \"npm start -w auth-service\" \"npm start -w ticket-service\" \"npm start -w notification-service\" \"npm start -w api-gateway\" \"npm start -w analytics-service\"",
    "dev:no-notification": "concurrently -n department,auth,ticket,gateway -c blue,cyan,green,magenta \"npm start -w department-service\" \"npm start -w auth-service\" \"npm start -w ticket-service\" \"npm start -w api-gateway\"",
    "notification": "npm start -w notification-service",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "node --env-file-if-exists=.env.demo tests/e2e.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:ui:responsive": "node tests/ui-responsive.mjs",
    "dev:web": "npm run dev -w chula-fondue-frontend",
    "setup:demo": "node scripts/setup-demo.mjs",
    "seed:demo": "node --env-file-if-exists=.env.demo scripts/seed-demo.mjs",
    "test:recovery": "node --env-file-if-exists=.env.demo tests/recovery.mjs",
    "test:routing": "node --env-file-if-exists=.env.demo tests/routing-e2e.mjs",
    "test:routing:recovery": "node --env-file-if-exists=.env.demo tests/routing-recovery.mjs",
    "test:ui:live": "node tests/ui-live.mjs",
    "test:load": "node scripts/run-load-tests.mjs average",
    "test:stress": "node scripts/run-load-tests.mjs stress",
    "test:perf": "node scripts/run-load-tests.mjs all",
    "test:perf:unit": "node --test tests/load-test.test.mjs",
    "test:platform": "node --env-file-if-exists=.env.demo --test tests/platform.integration.test.mjs",
    "test:platform:e2e": "node --env-file-if-exists=.env.demo tests/platform-e2e.mjs",
    "test:platform:ui": "node --env-file-if-exists=.env.demo tests/platform-ui.mjs",
    "test:ui:auth-tabs": "node tests/ui-auth-tabs.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "@playwright/test": "^1.56.1"
  }
}
