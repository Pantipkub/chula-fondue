%%{init: {"theme":"base","themeVariables":{"primaryColor":"#DCEEFF","primaryTextColor":"#17324D","primaryBorderColor":"#5798D0","lineColor":"#526777","secondaryColor":"#F0F5F8","tertiaryColor":"#FFFFFF","clusterBkg":"#F6F9FB","clusterBorder":"#9BB9D0"},"flowchart":{"curve":"basis","nodeSpacing":42,"rankSpacing":55}}}%%
flowchart LR
  browser["Campus User<br/>Browser"]

  subgraph host["Host machine · Docker Compose"]
    direction TB
    frontend["Frontend container<br/>nginx · host 127.0.0.1:8080"]
    gateway["API Gateway container<br/>host 127.0.0.1:3000"]
    subgraph network["Private backend network · Docker DNS service names"]
      direction TB
      subgraph apps["Application containers"]
        direction LR
        auth["Auth<br/>:3002"]
        dept["Department<br/>:3001"]
        ticket["Ticket<br/>gRPC :50051"]
        notify["Notification<br/>:8082"]
        analytics["Analytics<br/>:3003"]
      end
      subgraph infra["Infrastructure containers"]
        direction LR
        postgres[("PostgreSQL<br/>:5432")]
        rabbit[("RabbitMQ<br/>:5672")]
        mongo[("MongoDB local fallback<br/>:27017")]
      end
    end
    volumes[("Persistent Docker volumes<br/>PostgreSQL · RabbitMQ · MongoDB · uploads")]
  end

  atlas[("MongoDB Atlas<br/>Optional instead of local MongoDB")]
  cloud["Cloudinary<br/>Optional photo storage"]
  gmail["Gmail API<br/>Optional email delivery"]

  browser -->|HTTP :8080| frontend
  browser -.->|Direct API / local tooling · :3000| gateway
  frontend -->|/api proxy| gateway
  gateway -->|REST · internal DNS| auth
  gateway -->|REST · internal DNS| dept
  gateway -->|gRPC · internal DNS| ticket
  gateway -->|REST · internal DNS| notify
  gateway -->|REST · internal DNS| analytics
  auth & dept & ticket & analytics -->|SQL| postgres
  ticket & notify & analytics -->|AMQP| rabbit
  notify -->|MongoDB protocol| mongo
  postgres & rabbit & mongo -.->|Persist data| volumes
  notify -.->|Optional MongoDB connection| atlas
  notify -.->|Optional HTTPS email| gmail
  gateway -.->|Optional HTTPS photo upload| cloud

  subgraph legend["LEGEND"]
    direction LR
    lhost["Host deployment"]:::boundary
    lcontainer["Container"]:::container
    ldata[("Persistent data")]:::store
    lext["Optional external service"]:::external
  end

  classDef boundary fill:#F7FAFC,color:#17324D,stroke:#8EABBF,stroke-width:2px
  classDef container fill:#DCEEFF,color:#17324D,stroke:#5798D0,stroke-width:2px
  classDef store fill:#5D6D79,color:#FFFFFF,stroke:#43515B,stroke-width:2px
  classDef external fill:#FFF0E5,color:#9A461F,stroke:#D87645,stroke-width:2px
  class browser,lhost boundary
  class frontend,gateway,auth,dept,ticket,notify,analytics,lcontainer container
  class postgres,rabbit,mongo,volumes,ldata store
  class atlas,cloud,gmail,lext external
  style host fill:#F7FAFC,stroke:#8EABBF,stroke-width:2px
  style network fill:#F3F8FC,stroke:#9BB9D0,stroke-width:1.5px
  style apps fill:#FFFFFF,stroke:#B7CAD8,stroke-width:1px
  style infra fill:#FFFFFF,stroke:#B7CAD8,stroke-width:1px
  style legend fill:#FFFFFF,stroke:#B9C9D5,stroke-dasharray:4 3
