%%{init: {"theme":"base","themeVariables":{"fontFamily":"Inter, Arial, sans-serif","fontSize":"15px","primaryColor":"#E7F2FB","primaryTextColor":"#17324D","primaryBorderColor":"#5798D0","lineColor":"#526777","secondaryColor":"#F0F5F8","tertiaryColor":"#FFFFFF","clusterBkg":"#F6F9FB","clusterBorder":"#9BB9D0"},"flowchart":{"curve":"basis","nodeSpacing":38,"rankSpacing":62,"htmlLabels":true}}}%%
flowchart TB
  users["Campus Users<br/><small>Reporter · Guest · Admin · Staff</small>"]
  web["Web Frontend<br/><small>React + TypeScript · nginx</small>"]
  gateway["API Gateway<br/><small>NestJS · REST/JSON · JWT/RBAC</small>"]

  subgraph deploy["CHULA FONDUE · DOCKER COMPOSE NETWORK"]
    direction TB
    subgraph services["APPLICATION CONTAINERS"]
      direction LR
      auth["Auth Service<br/><small>NestJS · accounts / JWT</small>"]
      dept["Department Service<br/><small>NestJS · departments / rules</small>"]
      ticket["Ticket Service<br/><small>NestJS · gRPC :50051</small>"]
      notify["Notification Service<br/><small>NestJS · RabbitMQ consumer</small>"]
      analytics["Analytics Service<br/><small>NestJS · event projection</small>"]
    end

    subgraph data["DATA & MESSAGING"]
      direction LR
      subgraph pg["PostgreSQL 18 · one container, separate logical databases"]
        direction TB
        authdb[(auth database)]
        deptdb[(department database)]
        ticketdb[(ticket · history · outbox)]
        analyticsdb[(analytics database)]
      end
      rabbit[("RabbitMQ<br/><small>Durable notifications / analytics queues</small>")]
      mongo[("MongoDB<br/><small>Notification inbox</small>")]
      uploads[("Uploads volume<br/><small>Local photo fallback</small>")]
    end
  end
  cloud["Cloudinary<br/><small>Optional HTTPS photo store</small>"]

  users -->|HTTPS| web
  web -->|REST/JSON · /api| gateway
  gateway -->|REST| auth
  gateway -->|REST| dept
  gateway -->|gRPC| ticket
  gateway -->|REST| notify
  gateway -->|REST| analytics

  auth --> authdb
  dept --> deptdb
  ticket --> ticketdb
  analytics --> analyticsdb
  ticket -->|Transactional outbox · persistent event| rabbit
  rabbit -->|At least once · notifications queue| notify
  rabbit -->|At least once · analytics queue| analytics
  notify -->|Upsert · deduplicate by eventId| mongo
  gateway -->|Fallback photo storage| uploads
  gateway -.->|Optional photo upload · HTTPS| cloud
  uploads --> lperson

  subgraph legend["LEGEND"]
    direction LR
    lperson["Person"]:::person
    lcontainer["Application container"]:::container
    lstore[("Database / broker / volume")]:::store
    lexternal["External system"]:::external
    lasync["Async event flow"]:::async
  end

  classDef person fill:#164B78,color:#FFFFFF,stroke:#123B60,stroke-width:2px
  classDef container fill:#DCEEFF,color:#17324D,stroke:#5798D0,stroke-width:2px
  classDef store fill:#5D6D79,color:#FFFFFF,stroke:#43515B,stroke-width:2px
  classDef external fill:#667784,color:#FFFFFF,stroke:#4D5F6C,stroke-width:2px
  classDef async fill:#FFF0E5,color:#9A461F,stroke:#D87645,stroke-width:2px
  class users,lperson person
  class web,gateway,auth,dept,ticket,notify,analytics,lcontainer container
  class authdb,deptdb,ticketdb,analyticsdb,rabbit,mongo,uploads,lstore store
  class cloud,lexternal external
  class lasync async
  style deploy fill:#F7FAFC,stroke:#8EABBf,stroke-width:2px
  style services fill:#FFFFFF,stroke:#B7CAD8,stroke-width:1px
  style data fill:#FFFFFF,stroke:#B7CAD8,stroke-width:1px
  style pg fill:#F1F4F6,stroke:#8797A2,stroke-width:1.5px
  style legend fill:#FFFFFF,stroke:#B9C9D5,stroke-dasharray:4 3
  linkStyle 12,13 stroke:#D87645,stroke-width:3px
  linkStyle 17 stroke:transparent,stroke-width:0px,opacity:0
