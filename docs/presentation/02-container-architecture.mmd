%%{init: {"theme":"base","themeVariables":{"primaryColor":"#E7F2FB","primaryTextColor":"#17324D","primaryBorderColor":"#5798D0","lineColor":"#526777","secondaryColor":"#F0F5F8","tertiaryColor":"#FFFFFF","clusterBkg":"#F6F9FB","clusterBorder":"#9BB9D0"},"flowchart":{"curve":"basis","nodeSpacing":48,"rankSpacing":58}}}%%
flowchart LR
  users["Campus Users<br/>Reporter · Admin · Staff"]
  cloud["Cloudinary<br/>Optional photo storage"]
  gmail["Gmail API<br/>Optional outbound email"]

  subgraph deploy["CHULA FONDUE SYSTEM"]
    direction TB
    subgraph entry["WEB ENTRY"]
      direction LR
      web["Web Frontend<br/>React · nginx"]
      gateway["API Gateway<br/>NestJS · JWT / RBAC"]
      web -->|REST/JSON · /api| gateway
    end

    subgraph services["APPLICATION SERVICES"]
      direction LR
      auth["Auth Service<br/>accounts · sessions"]
      dept["Department Service<br/>departments · routing rules"]
      ticket["Ticket Service<br/>gRPC :50051"]
      notify["Notification Service<br/>RabbitMQ · email"]
      analytics["Analytics Service<br/>event projection"]
    end

    subgraph data["DATA & MESSAGING"]
      direction LR
      subgraph pg["PostgreSQL 18 · separate logical databases"]
        direction TB
        authdb[("auth · users · reset mail")]
        deptdb[(department)]
        ticketdb[("ticket · history · outbox · routing jobs")]
        analyticsdb[(analytics)]
      end
      rabbit[("RabbitMQ<br/>Durable notification / analytics queues")]
      mongo[("MongoDB<br/>Notification inbox")]
      uploads[("Uploads volume<br/>Local photo fallback")]
    end
  end

  users -->|Uses via browser| web
  gateway -->|REST · auth / session| auth
  gateway -->|REST| dept
  gateway -->|gRPC| ticket
  gateway -->|REST · inbox| notify
  gateway -->|REST · admin reports| analytics
  ticket -->|REST · department lookup / auto-routing| dept
  ticket -->|Transactional outbox · persistent event| rabbit
  rabbit -->|At least once · notifications| notify
  rabbit -->|At least once · analytics| analytics
  notify -->|Upsert · eventId deduplication| mongo
  auth -->|Internal REST · reset email| notify
  notify -.->|Optional HTTPS · Gmail API| gmail
  gateway -->|Photo fallback| uploads
  gateway -.->|Optional HTTPS upload| cloud

  subgraph legend["LEGEND"]
    direction LR
    lperson["Person"]:::person
    lcontainer["Application container"]:::container
    lstore[("Database / broker / volume")]:::store
    lexternal["External system"]:::external
    lasync["Async event flow"]:::async
  end

  classDef person fill:#164B78,color:#FFFFFF,stroke:#123B60,stroke-width:2px
  classDef container fill:#DCEEFF,color:#17324D,stroke:#5798D0,stroke-width:2px
  classDef store fill:#5D6D79,color:#FFFFFF,stroke:#43515B,stroke-width:2px
  classDef external fill:#667784,color:#FFFFFF,stroke:#4D5F6C,stroke-width:2px
  classDef async fill:#FFF0E5,color:#9A461F,stroke:#D87645,stroke-width:2px
  class users,lperson person
  class web,gateway,auth,dept,ticket,notify,analytics,lcontainer container
  class authdb,deptdb,ticketdb,analyticsdb,rabbit,mongo,uploads,lstore store
  class cloud,gmail,lexternal external
  class lasync async
  style deploy fill:#F7FAFC,stroke:#8EABBF,stroke-width:2px
  style entry fill:#FFFFFF,stroke:#B7CAD8,stroke-width:1px
  style services fill:#FFFFFF,stroke:#B7CAD8,stroke-width:1px
  style data fill:#FFFFFF,stroke:#B7CAD8,stroke-width:1px
  style pg fill:#F1F4F6,stroke:#8797A2,stroke-width:1.5px
  style legend fill:#FFFFFF,stroke:#B9C9D5,stroke-dasharray:4 3
